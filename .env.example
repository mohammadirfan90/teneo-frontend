# Backend API (server-only; never exposed to the browser)
API_BASE_URL=http://localhost:4000/api/v1

# Public site URL (metadata, Open Graph, Stripe return_url)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Stripe test-mode publishable key (same account as the backend's STRIPE_SECRET_KEY)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
